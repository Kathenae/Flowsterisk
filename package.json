{
  "name": "flowsterisk",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -c green,blue npm:client npm:server",
    "api:test": "cd api && bin/manage test",
    "client": "vite",
    "server": "cd api && php bin/manage run",
    "build": "tsc && vite build",
    "lint": "eslint src --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview"
  },
  "dependencies": {
    "@unocss/reset": "^0.53.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^7.18.3",
    "reactflow": "^11.7.2",
    "zustand": "^4.3.8"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.77",
    "@types/react": "^18.0.37",
    "@types/react-dom": "^18.0.11",
    "@typescript-eslint/eslint-plugin": "^5.59.0",
    "@typescript-eslint/parser": "^5.59.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^8.2.2",
    "eslint": "^8.38.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.3.4",
    "typescript": "^5.0.2",
    "unocss": "^66.9.2",
    "vite": "^8.2.2"
  }
}
